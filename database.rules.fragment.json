{
  "photoPreviewV1": {
    "galleries": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$photo": {
          ".validate": "$photo.matches(/^p([0-9]|1[0-9])$/) && newData.hasChildren(['id','name','data','createdAt','body','handle'])",
          "id": {
            ".validate": "newData.val() === $photo"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "data": {
            ".validate": "newData.isString() && ((newData.val().length <= 250000 && newData.val().beginsWith('data:image/jpeg;base64,') && data.exists() && newData.val() === data.val()) || (newData.val().length <= 300 && newData.val().matches(/^https:\\/\\/res\\.cloudinary\\.com\\/[a-zA-Z0-9_-]+\\/image\\/upload\\/[a-zA-Z0-9_\\/.%-]+$/)))"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "handle": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "comments": {
      ".read": true,
      ".indexOn": [
        "createdAt"
      ],
      "$comment": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['uid','author','text','createdAt'])",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
